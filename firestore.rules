rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cloud Sync: each room's currently-live match lives at liveMatches/{roomCode}. There's
    // no login in this app — the 6-character code itself is the "password" (like a meeting
    // link), so anyone who has it can read/write that one document. Nothing else is reachable.
    match /liveMatches/{roomCode} {
      allow read, write: if true;
    }
    // Rooms: tracks which two devices (at most) currently hold a room's slots, one per team,
    // and which team each slot is scoring for in the room's current match. Same no-login
    // model as liveMatches above — the room code is the password. The "only 2 devices" limit
    // itself is enforced app-side (see CloudSync.joinRoom), not by these rules.
    match /rooms/{roomCode} {
      allow read, write: if true;
    }
    // Team Sharing (Share Data page). Same no-login model as Rooms: the app itself enforces
    // Admin / Manager / User by mobile number. See README "Team Sharing security".
    match /team_members/{mobile} {
      allow read, write: if true;
    }
    match /team_matches/{matchKey} {
      allow read, write: if true;
    }
    match /team_squads/{publisher} {
      allow read, write: if true;
    }
    // App updates: phones may only ADD their email to the tester queue (never read the list);
    // the CI build (service account, bypasses rules) reads it and writes app_release.
    match /tester_requests/{email} {
      allow create, update: if true;
      allow read, delete: if false;
    }
    match /app_release/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
